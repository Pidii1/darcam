{
  "rewrites": [
    {
      "source": "/yt.php",
      "destination": "/api/yt"
    },
    {
      "source": "/jam.php",
      "destination": "/api/jam"
    },
    {
      "source": "/lyrics_proxy.php",
      "destination": "/api/lyrics"
    },
    {
      "source": "/friends.php",
      "destination": "/api/friends"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}